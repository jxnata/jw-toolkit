{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"exclude": ["node_modules"],
	"include": ["src/**/*", "nativewind-env.d.ts"],
	"files": [],
	"overrides": [
		{
			"files": ["**/*styles.ts"],
			"rules": {
				"@typescript-eslint/no-implicit-any": "off"
			}
		}
	]
}
