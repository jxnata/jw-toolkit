{
	"expo": {
		"name": "LS Mapas",
		"slug": "jw-toolkit",
		"scheme": "jw-toolkit",
		"version": "1.3.0",
		"orientation": "portrait",
		"icon": "./src/assets/icon.png",
		"userInterfaceStyle": "automatic",
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "dev.jxnata.jwtoolkit",
			"usesAppleSignIn": true,
			"googleServicesFile": "./GoogleService-Info.plist",
			"infoPlist": {
				"NSLocationWhenInUseUsageDescription": "Habilitar a localização vai permitir mostrar os mapas mais próximos de você. Essa informação não fica salva externamente nem é compartilhada.",
				"ITSAppUsesNonExemptEncryption": false
			},
			"appleTeamId": "N9G6UA9982",
			"config": {
				"googleMapsApiKey": "process.env.GOOGLE_MAPS_API_KEY"
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./src/assets/adaptive-icon.png",
				"backgroundColor": "#D08129"
			},
			"package": "dev.jxnata.jwmaps",
			"googleServicesFile": "./google-services.json",
			"permissions": [
				"android.permission.INTERNET",
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.SYSTEM_ALERT_WINDOW",
				"android.permission.VIBRATE",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"android.permission.ACCESS_FINE_LOCATION",
				"android.permission.ACCESS_COARSE_LOCATION",
				"com.android.vending.BILLING"
			],
			"config": {
				"googleMaps": {
					"apiKey": "AIzaSyBJJ6XnME22X2XA14CeyigGChZpijG15b0"
				}
			}
		},
		"web": {
			"favicon": "./src/assets/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			"expo-font",
			"expo-apple-authentication",
			"expo-notifications",
			"expo-sharing",
		    "expo-status-bar",
			[
        		"expo-build-properties",
		        {
		          "ios": {
		            "useFrameworks": "static"
		          }
		        }
		     ],
			[
			    "expo-splash-screen",
			    {
					"image": "./src/assets/icon.png",
					"resizeMode": "contain",
					"backgroundColor": "#D08129"
			    }
			],
			[
				"react-native-maps",
				{
					"androidGoogleMapsApiKey": "AIzaSyBJJ6XnME22X2XA14CeyigGChZpijG15b0"
				}
			],
			[
				"@react-native-google-signin/google-signin",
				{
					"iosUrlScheme": "com.googleusercontent.apps.561014260561-au4cn876vvjtjqhugoakvbiebsmpnlj1"
				}
			]
		],
		"experiments": {
			"tsconfigPaths": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "fd11d33c-dc78-4e42-8f4f-71f7de1cd229"
			}
		},
		"owner": "jxnata",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/fd11d33c-dc78-4e42-8f4f-71f7de1cd229"
		}
	}
}
